{
  "manifest_version": 2,
  "name": "Kosher Browsing Protections",
  "version": "2.7",
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@browser.local"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "background": {
    "scripts": [
      "adult-hosts.js",
      "policy.js",
      "rules.js",
      "captcha.js",
      "filter.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "css": [
        "content.css"
      ],
      "js": [
        "captcha.js",
        "filter.js",
        "content.js",
        "features.js"
      ]
    }
  ],
  "web_accessible_resources": [
    "blocked.html",
    "blocked.js",
    "blocked.css"
  ]
}
